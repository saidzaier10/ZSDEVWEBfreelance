# ============================================================
# .env.example — Copier vers .env et remplir les valeurs
# NE PAS committer le fichier .env
# ============================================================

# ── Django ───────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-real-secret-key

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,zsdevweb.com,www.zsdevweb.com

# ── Base de données ──────────────────────────────────────────
DB_NAME=zsdevweb
DB_USER=zs
DB_PASSWORD=changeme-strong-db-password
DB_HOST=db
DB_PORT=5432

# (Même valeur que DB_PASSWORD — utilisée par docker-compose)
POSTGRES_PASSWORD=changeme-strong-db-password

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-strong-redis-password

# ── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ZSDEVWeb <your-email@example.com>

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=https://zsdevweb.com

# ── Sécurité HTTPS (mettre True en production) ───────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://zsdevweb.com,https://www.zsdevweb.com

# ── WAF ──────────────────────────────────────────────────────
WAF_BLOCK_MODE=True
